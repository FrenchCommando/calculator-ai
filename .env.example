# Dev: copy to .env. Prod: copy to .env.production on the Pi (read by docker-compose, never committed).

# Apps are served at <app>.<ROOT_DOMAIN>. Dev: localhost (calc.localhost:3000 works in Chrome/Firefox).
# Prod: http.nyc
ROOT_DOMAIN=localhost
# Port inside the process. In Docker this stays 3000; the compose file maps it to the host's 127.0.0.1:3010.
PORT=3000

# Stripe. One account covers every app. https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Two recurring Prices: Pro $20/month and Max $200/month.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MAX=price_...

# Where the Enterprise button sends leads.
SALES_EMAIL=you@example.com
